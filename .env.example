# Hopper — Docker settings
# Copy to .env (next to docker-compose.yml) and adjust. Every line is
# optional; .env is git-ignored. Apply changes with: docker compose up -d

# ── Container ─────────────────────────────────────────────────────────────────
IMAGE_TAG=latest            # image tag, e.g. v0.6.0 to pin a release

# uid/gid that owns your downloads (`id <user>` on the host; often 1026/100
# on Synology, 99/100 on Unraid)
PUID=1000
PGID=1000

# ── Host paths ────────────────────────────────────────────────────────────────
CONFIG_DIR=./config         # database, secrets.json (back it up), optional hopper.yaml
DOWNLOADS_DIR=./downloads   # e.g. /volume1/downloads or an existing media library

# ── Ports ─────────────────────────────────────────────────────────────────────
WEB_PORT=9667               # Web UI / API on the host
CNL_HOST=127.0.0.1          # 0.0.0.0 = Click'n'Load reachable from your LAN (NAS setup)
CNL_PORT=9666               # browser Click'n'Load buttons always use 9666

# ── Hopper ────────────────────────────────────────────────────────────────────
# Everything starting with HOPPER_ is passed to hopperd. Leave a line
# commented out to keep the default (or the value from config/hopper.yaml).
# All settings: https://github.com/simuuh/hopper-downloader/blob/main/hopper.example.yaml

# Push notification when a package is finished (webhook and/or ntfy)
#HOPPER_NOTIFY_WEBHOOK_URL=http://homeassistant.lan:8123/api/webhook/hopper
#HOPPER_NOTIFY_NTFY_URL=https://ntfy.sh/my-hopper-topic
#HOPPER_NOTIFY_NTFY_TOKEN=

#HOPPER_LOG_LEVEL=info

# Admin password: generated on first start and printed once
# (docker compose logs hopperd); change it with
#   docker compose exec -it hopperd hopperd -set-admin-password
# To set a hash here instead, keep the SINGLE quotes — the hash contains $:
#HOPPER_ADMIN_PASSWORD_HASH='$2a$10$...'
