{
  "manifest_version": 3,
  "name": "Hopper",
  "version": "1.1.0",
  "description": "Route Click'n'Load and .dlc downloads to Hopper",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Hopper",
    "default_popup": "popup.html"
  },
  "permissions": ["declarativeNetRequest", "storage", "downloads"],
  "host_permissions": [
    "http://127.0.0.1:9666/*",
    "https://127.0.0.1:9666/*",
    "http://*/*",
    "https://*/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hopper@simuuh.ovh",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "scripts": ["service-worker.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
